# Stripe Configuration (from Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# Google Identity Services (Client ID from Google Cloud Console > APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Host Email & SMTP Configuration for Tenancy Submissions & Customer Receipts
# Submissions from "Share Your Tenancy Experience Privately" will be forwarded directly to this host inbox
HOST_EMAIL=host@landlordsbc.org

# SMTP Server details (e.g. SendGrid, Mailgun, AWS SES, or Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@landlordsbc.org
SMTP_PASS=your_smtp_app_password
SMTP_FROM=Landlords BC Intake <notifications@landlordsbc.org>

# Port (optional)
PORT=3000
